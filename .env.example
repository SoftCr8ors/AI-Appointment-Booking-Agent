 # ============================================================================
  # REQUIRED: Secrets and API credentials
  # ============================================================================
  GEMINI_API_KEY=
  GEMINI_MODEL=gemini-2.5-flash
  CALENDAR_ID=
  TIMEZONE=Asia/Karachi
  
  # Service account: use ONE of these two methods
  # Method 1 (local dev): path to JSON file
  GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
  
  # Method 2 (production): paste entire JSON as string
  GOOGLE_SERVICE_ACCOUNT_JSON=
  
  # ============================================================================
  # OPTIONAL: Business rules (defaults shown, uncomment to customize)
  # ============================================================================
  # Business hours (24-hour format HH:MM)
  # BUSINESS_START=10:00
  # BUSINESS_END=18:00
  
  # Appointment slot duration in minutes
  # SLOT_MINUTES=60
  
  # Working days (0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun)
  # WORKING_DAYS=0,1,2,3,4
  
  # Minimum notice required before booking (in minutes)
  # MIN_NOTICE_MINUTES=60
  
  # Maximum days in advance for booking
  # MAX_DAYS_AHEAD=60
  
  # Available services (comma-separated, lowercase)
  # SERVICES=consultation,follow-up,demo